[Unit]
Description=DodoRouter LLM Proxy
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/dodo-router
EnvironmentFile=%h/dodo-router/.env
Environment="PHX_SERVER=true"
Environment="HOME=%h"
ExecStart=%h/dodo-router/bin/dodo_router start
ExecStop=%h/dodo-router/bin/dodo_router stop
ExecReload=%h/dodo-router/bin/dodo_router restart
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dodo-router

# Graceful shutdown
TimeoutStopSec=30
KillSignal=SIGTERM

[Install]
WantedBy=default.target
