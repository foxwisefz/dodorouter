<!DOCTYPE html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="DodoRouter">
      {assigns[:page_title]}
    </.live_title>
    <link rel="icon" type="image/png" sizes="32x32" href={~p"/favicon-32.png"} />
    <link rel="icon" type="image/png" sizes="16x16" href={~p"/favicon-16.png"} />
    <link rel="apple-touch-icon" sizes="180x180" href={~p"/apple-touch-icon.png"} />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body class="min-h-screen bg-base-200">
    <%= if @current_scope && @current_scope.user do %>
      <div class="drawer lg:drawer-open">
        <input id="sidebar-drawer" type="checkbox" class="drawer-toggle" />

        <div class="drawer-content flex flex-col">
          <!-- Navbar -->
          <div class="navbar bg-base-100 border-b border-base-300 lg:hidden">
            <div class="flex-none">
              <label for="sidebar-drawer" class="btn btn-square btn-ghost drawer-button">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="inline-block w-5 h-5 stroke-current">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                </svg>
              </label>
            </div>
            <div class="flex-1">
              <span class="text-xl font-bold">DodoRouter</span>
            </div>
          </div>

          <!-- Page content -->
          <div class="flex-1 p-6">
            {@inner_content}
          </div>
        </div>

        <!-- Sidebar -->
        <div class="drawer-side z-40">
          <label for="sidebar-drawer" class="drawer-overlay"></label>
          <aside class="bg-base-100 min-h-screen w-64 border-r border-base-300">
            <!-- Logo -->
            <div class="p-4 border-b border-base-300">
              <a href={~p"/projects"} class="flex items-center gap-2">
                <img src={~p"/images/dodo-logo.png"} alt="DodoRouter" class="w-10 h-10" />
                <span class="text-xl font-bold">DodoRouter</span>
              </a>
            </div>

            <!-- Navigation -->
            <ul class="menu p-4 gap-1">
              <li class="menu-title">Navigation</li>
              <li>
                <a href={~p"/dashboard"} class="gap-3">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                  </svg>
                  Dashboard
                </a>
              </li>
              <li>
                <a href={~p"/projects"} class="gap-3">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
                  </svg>
                  Projects
                </a>
              </li>
              <li>
                <a href={~p"/logs"} class="gap-3">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                  </svg>
                  Logs
                </a>
              </li>

              <li class="menu-title mt-4">Account</li>
              <li>
                <a href={~p"/users/settings"} class="gap-3">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  Settings
                </a>
              </li>
              <li>
                <.link href={~p"/users/log-out"} method="delete" class="gap-3">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                  </svg>
                  Log out
                </.link>
              </li>
            </ul>

            <!-- User info at bottom -->
            <div class="absolute bottom-0 w-full p-4 border-t border-base-300">
              <div class="flex items-center gap-3">
                <div class="avatar placeholder">
                  <div class="bg-neutral text-neutral-content rounded-full w-10">
                    <span class="text-sm"><%= String.first(@current_scope.user.email) |> String.upcase() %></span>
                  </div>
                </div>
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-medium truncate"><%= @current_scope.user.email %></p>
                </div>
              </div>
            </div>
          </aside>
        </div>
      </div>
    <% else %>
      <!-- Non-authenticated layout -->
      <div class="min-h-screen flex flex-col">
        <div class="navbar bg-base-100 border-b border-base-300">
          <div class="flex-1">
            <a href={~p"/"} class="btn btn-ghost text-xl">DodoRouter</a>
          </div>
          <div class="flex-none">
            <ul class="menu menu-horizontal px-1">
              <li><a href={~p"/users/register"}>Register</a></li>
              <li><a href={~p"/users/log-in"}>Log in</a></li>
            </ul>
          </div>
        </div>
        <div class="flex-1 p-6">
          {@inner_content}
        </div>
      </div>
    <% end %>
  </body>
</html>
